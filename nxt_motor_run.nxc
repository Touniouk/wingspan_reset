// Runs a motor continuously at a set speed, standalone on the NXT brick.
// Compile with NBC/NXC and upload the resulting .rxe file to the brick over USB.
// Once uploaded, run it from the brick's "My Files" menu with no PC attached.

#define MOTOR_PORT OUT_A   // OUT_A, OUT_B, or OUT_C
#define SPEED 75           // -100 (full reverse) to 100 (full forward)

task main()
{
    OnFwd(MOTOR_PORT, SPEED);

    while (true)
    {
        Wait(100);
    }
}
